Project snapgram {
  database_type: 'PostgreSQL'
  Note: 'SNAPGRAM DBML v3.0. Seven PostgreSQL DBs, one DB per service. Solid relationships = real FK inside the same DB. Dashed-looking semantics are represented by Ref comments/notes for cross-service logical UUID references; these are NOT SQL FKs across databases. Fully synchronized with all Flyway migrations.'
}

// ============================================================
// 1. AUTH DB — auth-service
// Source of truth: identity, profile, privacy, block, presence, notes
// ============================================================
Enum user_role {
  USER
  ADMIN
}

Table auth_users {
  id uuid [pk]
  username varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null, default: 'USER']
  failed_login_attempts int [not null, default: 0]
  locked_until timestamptz
  display_name varchar(100)
  avatar_url varchar(500)
  bio text
  website varchar(500)
  pronouns varchar(50)
  category varchar(100)
  is_private boolean [not null, default: false]
  totp_secret varchar(255) [note: 'Encrypted AES-GCM; optional when 2FA disabled']
  two_fa_enabled boolean [not null, default: false]
  backup_codes_hash text [note: 'Hashed backup codes; shown once during setup']
  email_verified boolean [not null, default: false]
  email_verified_at timestamptz
  show_activity_status boolean [not null, default: true]
  last_seen_at timestamptz
  is_banned boolean [not null, default: false]
  banned_at timestamptz
  ban_reason varchar(255)
  is_verified boolean [not null, default: false, note: 'Blue tick verification status granted via payment.completed event']
  verified_until timestamptz [note: 'Cumulative expiration timestamp of blue tick verification']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    role
    is_banned
    verified_until
  }
}

Table auth_user_roles {
  id uuid [pk]
  user_id uuid [not null]
  role varchar(50) [not null]
  created_at timestamptz [not null]

  Indexes {
    (user_id, role) [unique]
    user_id
    role
  }
}

Table auth_roles {
  id uuid [pk]
  name varchar(50) [not null, unique]
  description varchar(255)
  is_system boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    name [unique]
  }
}

Table auth_permissions {
  id uuid [pk]
  name varchar(100) [not null, unique]
  category varchar(50) [not null]
  description varchar(255)
  created_at timestamptz [not null]

  Indexes {
    name [unique]
    category
  }
}

Table auth_role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (role_id, permission_id) [pk]
    role_id
    permission_id
  }
}

Table auth_refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  jti varchar(100) [not null, unique]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    user_id
    expires_at
    revoked_at
  }
}

Table auth_blocks {
  id uuid [pk]
  blocker_id uuid [not null]
  blocked_id uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (blocker_id, blocked_id) [unique]
    blocker_id
    blocked_id
  }

  Note: 'A→B blocks B. Enforce blocker_id <> blocked_id in application/SQL constraint.'
}

Table auth_notes {
  id uuid [pk]
  user_id uuid [not null]
  content varchar(60) [not null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]

  Indexes {
    user_id
    expires_at
  }
}

Table auth_email_verifications {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique, note: 'SHA-256 hash of the raw token sent via email']
  new_email varchar(255) [note: 'NULL = verify current email; non-NULL = pending email change']
  expires_at timestamptz [not null]
  used_at timestamptz [note: 'NULL = not yet used; set on successful verification']
  created_at timestamptz [not null]

  Indexes {
    user_id
    token_hash
    expires_at
    used_at
  }

  Note: 'One active token per user at a time (used_at IS NULL AND expires_at > now). Application enforces uniqueness; old tokens are invalidated on new request.'
}

Table auth_password_resets {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique, note: 'SHA-256 hash of the raw reset token sent via email']
  expires_at timestamptz [not null]
  used_at timestamptz [note: 'NULL = not yet used; set on successful password reset']
  ip_address varchar(45) [note: 'IPv4 or IPv6 of requester for audit/abuse detection']
  created_at timestamptz [not null]

  Indexes {
    user_id
    token_hash
    expires_at
    used_at
  }

  Note: 'Token is single-use (used_at set on first use). Expires in 15 minutes. Multiple active tokens allowed per user but only latest is shown — old ones are invalidated on new request.'
}

Table auth_payment_processed_events {
  event_id varchar(128) [pk, note: 'Idempotency key: stable eventId from payment-service']
  user_id uuid [not null]
  product_code varchar(64) [not null]
  granted_until timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
  }
}

Table auth_oauth_accounts {
  id uuid [pk]
  user_id uuid [not null]
  provider varchar(50) [not null, note: 'FACEBOOK / GOOGLE']
  provider_user_id varchar(255) [not null]
  email varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (provider, provider_user_id) [unique]
    user_id
  }
}

Ref: auth_users.id < auth_user_roles.user_id
Ref: auth_roles.name < auth_user_roles.role
Ref: auth_roles.id < auth_role_permissions.role_id
Ref: auth_permissions.id < auth_role_permissions.permission_id
Ref: auth_users.id < auth_refresh_tokens.user_id
Ref: auth_users.id < auth_blocks.blocker_id
Ref: auth_users.id < auth_blocks.blocked_id
Ref: auth_users.id < auth_notes.user_id
Ref: auth_users.id < auth_email_verifications.user_id
Ref: auth_users.id < auth_password_resets.user_id
Ref: auth_users.id < auth_payment_processed_events.user_id
Ref: auth_users.id < auth_oauth_accounts.user_id

TableGroup AUTH_DB {
  auth_users
  auth_user_roles
  auth_roles
  auth_permissions
  auth_role_permissions
  auth_refresh_tokens
  auth_blocks
  auth_notes
  auth_email_verifications
  auth_password_resets
  auth_payment_processed_events
  auth_oauth_accounts
}

// ============================================================
// 2. MEDIA DB — media-service
// Source of truth: uploaded media metadata + object storage identity
// ============================================================
Table media_files {
  id uuid [pk]
  owner_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id; NOT a cross-DB FK']
  bucket varchar(100) [not null]
  object_key varchar(500) [not null, unique]
  mime_type varchar(150) [not null]
  size_bytes bigint [not null]
  url varchar(1000)
  thumbnail_url varchar(1000)
  status varchar(30) [not null, note: 'UPLOADING / READY / DELETED / ORPHAN']
  created_at timestamptz [not null]
  updated_at timestamptz

  Indexes {
    owner_id
    status
    created_at
  }
}

Table media_metadata {
  media_id uuid [pk]
  width int
  height int
  duration_sec int
  exif_stripped boolean [not null, default: true]
  metadata jsonb
}

Ref: media_files.id - media_metadata.media_id

TableGroup MEDIA_DB {
  media_files
  media_metadata
}

// ============================================================
// 3. CONTENT DB — content-service
// Source of truth: posts, comments, interactions, follows, stories
// ============================================================
Table content_posts {
  id uuid [pk]
  author_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  content_type varchar(20) [not null, note: 'IMAGE / VIDEO / CAROUSEL / TEXT']
  caption text
  media_id uuid [note: 'Recommended normalized logical reference → media_db.media_files.id (cover item)']
  media_url varchar(1000) [note: 'Optional resolved/snapshot URL; cover/preview item']
  tags text
  like_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  view_count bigint [not null, default: 0]
  status varchar(20) [not null, note: 'PUBLISHED / ARCHIVED / DRAFT']
  edited_at timestamptz
  edit_count int [not null, default: 0]
  visibility varchar(30) [not null, note: 'PUBLIC / FOLLOWERS_ONLY']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    author_id
    status
    visibility
    media_id
    created_at
  }
}

Table content_post_media {
  id uuid [pk]
  post_id uuid [not null]
  media_id uuid [note: 'Logical reference → media_db.media_files.id']
  media_url varchar(1000) [not null]
  thumbnail_url varchar(1000)
  media_type varchar(20) [not null, note: 'IMAGE / VIDEO']
  sort_order int [not null, default: 0, note: 'Display sequence in carousel/album (0-indexed)']
  width int
  height int
  duration_sec int [note: 'Duration in seconds if video']
  created_at timestamptz [not null]

  Indexes {
    post_id
    (post_id, sort_order) [unique]
  }

  Note: 'Supports multiple photos/videos per post (Carousel / Album). 1 post has 1..N media items.'
}

Table content_comments {
  id uuid [pk]
  post_id uuid [not null]
  author_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  content text [note: 'Nullable when comment contains only media (image/GIF/sticker)']
  media_url varchar(1000)
  media_type varchar(20) [note: 'IMAGE / GIF / STICKER']
  parent_comment_id uuid [note: 'NULL = root comment; non-NULL = reply. Business rule: max depth 1.']
  like_count bigint [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz

  Indexes {
    post_id
    author_id
    parent_comment_id
    created_at
    media_type
  }

  Note: 'Self-reference implements Comment → Reply. Parent must belong to the same post; service enforces one reply level.'
}

Table content_comment_likes {
  comment_id uuid [not null]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  created_at timestamptz [not null]

  Indexes {
    (comment_id, user_id) [pk]
    user_id
  }
}

Table content_interactions {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  post_id uuid [not null]
  type varchar(20) [not null, note: 'LIKE / VIEW / SHARE / COMMENT / SKIP']
  watch_time_ratio decimal(6,5)
  explicit_rating decimal(4,2)
  created_at timestamptz [not null]

  Indexes {
    (user_id, post_id, type)
    post_id
    type
    created_at
  }
}

Table content_follows {
  id uuid [pk]
  follower_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  following_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  status varchar(20) [not null, note: 'PENDING / ACCEPTED']
  created_at timestamptz [not null]

  Indexes {
    (follower_id, following_id) [unique]
    follower_id
    following_id
    status
  }

  Note: 'Store A→B and B→A as two independent rows. MUTUAL is derived when both rows are ACCEPTED; never store MUTUAL.'
}

Table content_user_privacy_view {
  user_id uuid [pk, note: 'Logical reference → auth_db.auth_users.id']
  is_private boolean [not null]
  updated_at timestamptz [not null]

  Note: 'CQRS projection from user.events; not source of truth.'
}

Table content_saved_posts {
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  post_id uuid [not null]
  collection_id uuid
  saved_at timestamptz [not null]

  Indexes {
    (user_id, post_id) [pk]
    post_id
    collection_id
  }
}

Table content_collections {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  name varchar(100) [not null]
  is_private boolean [not null, default: true]
  cover_post_id uuid
  created_at timestamptz [not null]

  Indexes {
    user_id
  }
}

Table content_reports {
  id uuid [pk]
  reporter_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  target_type varchar(30) [not null, note: 'POST / COMMENT / USER']
  target_id uuid [not null, note: 'Polymorphic logical reference; no single SQL FK possible']
  reason varchar(100) [not null]
  description text
  status varchar(30) [not null, note: 'PENDING / REVIEWING / RESOLVED / REJECTED']
  created_at timestamptz [not null]
  updated_at timestamptz

  Indexes {
    reporter_id
    (target_type, target_id)
    status
  }
}

Table content_mutes {
  id uuid [pk]
  muter_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  muted_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  created_at timestamptz [not null]

  Indexes {
    (muter_id, muted_id) [unique]
    muter_id
    muted_id
  }
}

Table content_stories {
  id uuid [pk]
  author_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  media_id uuid [note: 'Logical reference → media_db.media_files.id']
  media_url varchar(1000) [not null]
  media_type varchar(30) [not null]
  caption text
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  visibility varchar(30) [not null, note: 'PUBLIC / FOLLOWERS_ONLY / CLOSE_FRIENDS']

  Indexes {
    author_id
    media_id
    expires_at
    visibility
  }
}

Table content_story_views {
  story_id uuid [not null]
  viewer_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  viewed_at timestamptz [not null]

  Indexes {
    (story_id, viewer_id) [pk]
    viewer_id
  }
}

Table content_highlights {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  name varchar(100) [not null]
  cover_story_id uuid
  created_at timestamptz [not null]

  Indexes {
    user_id
    cover_story_id
  }
}

Table content_highlight_items {
  highlight_id uuid [not null]
  story_id uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (highlight_id, story_id) [pk]
    story_id
  }
}

Table content_hashtags {
  id uuid [pk]
  tag varchar(100) [not null, unique]
  post_count bigint [not null, default: 0]
  last_used_at timestamptz
}

Table content_post_hashtags {
  post_id uuid [not null]
  hashtag_id uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (post_id, hashtag_id) [pk]
    hashtag_id
  }
}

Table content_close_friends {
  owner_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  friend_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  created_at timestamptz [not null]

  Indexes {
    (owner_id, friend_id) [pk]
    friend_id
  }
}

Table content_post_mentions {
  post_id uuid [not null]
  mentioned_user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  created_at timestamptz [not null]

  Indexes {
    (post_id, mentioned_user_id) [pk]
    mentioned_user_id
  }
}

Table support_tickets {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  category varchar(50) [not null, note: 'ACCOUNT / CONTENT / BILLING / TECHNICAL / OTHER']
  subject varchar(200) [not null]
  description text [not null]
  attachments jsonb [default: `'[]'`]
  status varchar(20) [not null, default: 'OPEN', note: 'OPEN / IN_PROGRESS / RESOLVED / CLOSED']
  priority varchar(20) [not null, default: 'NORMAL', note: 'LOW / NORMAL / HIGH / URGENT']
  admin_reply text
  responder_id uuid [note: 'Logical reference → auth_db.auth_users.id']
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    status
    created_at
  }
}

Ref: content_posts.id < content_comments.post_id
Ref: content_posts.id < content_post_media.post_id
Ref: content_comments.id < content_comments.parent_comment_id
Ref: content_comments.id < content_comment_likes.comment_id
Ref: content_posts.id < content_interactions.post_id
Ref: content_posts.id < content_saved_posts.post_id
Ref: content_collections.id < content_saved_posts.collection_id
Ref: content_posts.id < content_collections.cover_post_id
Ref: content_stories.id < content_story_views.story_id
Ref: content_highlights.id < content_highlight_items.highlight_id
Ref: content_stories.id < content_highlight_items.story_id
Ref: content_stories.id < content_highlights.cover_story_id
Ref: content_posts.id < content_post_hashtags.post_id
Ref: content_hashtags.id < content_post_hashtags.hashtag_id
Ref: content_posts.id < content_post_mentions.post_id

TableGroup CONTENT_DB {
  content_posts
  content_post_media
  content_comments
  content_comment_likes
  content_interactions
  content_follows
  content_user_privacy_view
  content_saved_posts
  content_collections
  content_reports
  content_mutes
  content_stories
  content_story_views
  content_highlights
  content_highlight_items
  content_hashtags
  content_post_hashtags
  content_close_friends
  content_post_mentions
  support_tickets
}

// ============================================================
// 4. CHAT DB — chat-service
// ============================================================
Table chat_conversations {
  id uuid [pk]
  type varchar(20) [not null, note: 'DIRECT / GROUP']
  name varchar(150)
  avatar_url varchar(1000)
  created_by uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  vanish_mode_enabled boolean [not null, default: false]
  vanish_mode_set_by uuid [note: 'Logical reference → auth_db.auth_users.id']
  vanish_mode_set_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz

  Indexes {
    type
    created_by
  }
}

Table chat_conversation_members {
  id uuid [pk]
  conversation_id uuid [not null]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  role varchar(20) [not null, note: 'ADMIN / MEMBER']
  joined_at timestamptz [not null]
  left_at timestamptz
  archived boolean [not null, default: false]
  muted boolean [not null, default: false]
  muted_until timestamptz

  Indexes {
    (conversation_id, user_id)
    conversation_id
    user_id
  }

  Note: 'Business rule from PLAN: only one active membership per conversation/user where left_at IS NULL (partial unique index in SQL migration).'
}

Table chat_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  type varchar(30) [not null, note: 'TEXT / IMAGE / VIDEO / VOICE / FILE / POST_SHARE']
  content text
  media_id uuid [note: 'Logical reference → media_db.media_files.id']
  media_url varchar(1000)
  media_mime_type varchar(150)
  media_size_bytes bigint
  media_duration_sec int
  thumbnail_url varchar(1000)
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_for_everyone boolean [not null, default: false]
  reply_to_message_id uuid
  is_forwarded boolean [not null, default: false]
  forwarded_from_message_id uuid
  is_ephemeral boolean [not null, default: false]
  expires_at timestamptz
  created_at timestamptz [not null]
  edited_at timestamptz

  Indexes {
    conversation_id
    sender_id
    media_id
    reply_to_message_id
    forwarded_from_message_id
    expires_at
    created_at
  }

  Note: 'POST_SHARE carries the shared content post UUID logically; use payload/target fields if a dedicated post reference is needed later.'
}

Table chat_message_reactions {
  id uuid [pk]
  message_id uuid [not null]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  emoji varchar(20) [not null]
  created_at timestamptz [not null]

  Indexes {
    (message_id, user_id) [unique]
    message_id
    user_id
  }
}

Table chat_conversation_read_status {
  conversation_id uuid [not null]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  last_read_message_id uuid [not null]
  updated_at timestamptz [not null]

  Indexes {
    (conversation_id, user_id) [pk]
    user_id
  }
}

Table chat_message_hidden {
  message_id uuid [not null]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  hidden_at timestamptz [not null]

  Indexes {
    (message_id, user_id) [pk]
    user_id
  }
}

Table chat_pinned_messages {
  conversation_id uuid [not null]
  message_id uuid [not null]
  pinned_by uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  pinned_at timestamptz [not null]

  Indexes {
    (conversation_id, message_id) [pk]
    message_id
  }
}

Table chat_call_history {
  id uuid [pk]
  conversation_id uuid [not null]
  initiated_by uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  status varchar(20) [not null, note: 'COMPLETED / MISSED / REJECTED']
  started_at timestamptz
  ended_at timestamptz

  Indexes {
    conversation_id
    initiated_by
    status
    started_at
  }
}

Ref: chat_conversations.id < chat_conversation_members.conversation_id
Ref: chat_conversations.id < chat_messages.conversation_id
Ref: chat_messages.id < chat_message_reactions.message_id
Ref: chat_conversations.id < chat_conversation_read_status.conversation_id
Ref: chat_messages.id < chat_conversation_read_status.last_read_message_id
Ref: chat_messages.id < chat_message_hidden.message_id
Ref: chat_conversations.id < chat_pinned_messages.conversation_id
Ref: chat_messages.id < chat_pinned_messages.message_id
Ref: chat_conversations.id < chat_call_history.conversation_id
Ref: chat_messages.id < chat_messages.reply_to_message_id
Ref: chat_messages.id < chat_messages.forwarded_from_message_id

TableGroup CHAT_DB {
  chat_conversations
  chat_conversation_members
  chat_messages
  chat_message_reactions
  chat_conversation_read_status
  chat_message_hidden
  chat_pinned_messages
  chat_call_history
}

// ============================================================
// 5. RECOMMENDER DB — recommender-service (CQRS read model)
// ============================================================
Table recommender_post_view {
  post_id uuid [pk, note: 'Logical reference → content_db.content_posts.id']
  author_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  content_type varchar(20) [not null]
  caption text
  tags text
  visibility varchar(30) [not null]
  author_is_private boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz

  Indexes {
    author_id
    visibility
    created_at
  }
}

Table recommender_interaction_view {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  post_id uuid [not null, note: 'Logical reference → content_db.content_posts.id']
  type varchar(20) [not null]
  watch_time_ratio decimal(6,5)
  explicit_rating decimal(4,2)
  created_at timestamptz [not null]

  Indexes {
    (user_id, created_at)
    post_id
    type
  }
}

Table recommender_follow_view {
  follower_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  following_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  status varchar(20) [not null]
  created_at timestamptz [not null]

  Indexes {
    (follower_id, following_id) [pk]
    following_id
    status
  }

  Note: 'Projection of content_follows. Mutual is derived, not stored.'
}

Table recommender_block_view {
  blocker_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  blocked_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  updated_at timestamptz [not null]

  Indexes {
    (blocker_id, blocked_id) [pk]
    blocked_id
  }
}

Table recommender_mute_view {
  muter_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  muted_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  updated_at timestamptz [not null]

  Indexes {
    (muter_id, muted_id) [pk]
    muted_id
  }
}

Table recommender_trending_post {
  id uuid [pk]
  post_id uuid [not null, unique, note: 'Logical reference → content_db.content_posts.id']
  author_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  content_type varchar(20) [not null]
  caption text
  tags text
  score double [not null]
  likes_count bigint [not null, default: 0]
  rank integer [not null, default: 0]
  calculated_at timestamptz [not null, default: `now()`]

  Indexes {
    (calculated_at, score)
    post_id [unique]
  }

  Note: 'Batch job result: Top trending posts computed periodically based on interaction and recency decay.'
}

Table recommender_user_recommendation {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  recommended_user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  score double [not null]
  mutual_friends_count bigint [not null, default: 0]
  reason varchar(255)
  calculated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, score)
    (user_id, recommended_user_id) [unique]
  }

  Note: 'Batch job result: Personalized user recommendations computed from graph mutuals and common interests.'
}

Table BATCH_JOB_INSTANCE {
  JOB_INSTANCE_ID bigint [pk]
  VERSION bigint
  JOB_NAME varchar(100) [not null]
  JOB_KEY varchar(32) [not null]

  Indexes {
    (JOB_NAME, JOB_KEY) [unique]
  }
}

Table BATCH_JOB_EXECUTION {
  JOB_EXECUTION_ID bigint [pk]
  VERSION bigint
  JOB_INSTANCE_ID bigint [not null]
  CREATE_TIME timestamp [not null]
  START_TIME timestamp
  END_TIME timestamp
  STATUS varchar(10)
  EXIT_CODE varchar(2500)
  EXIT_MESSAGE varchar(2500)
  LAST_UPDATED timestamp
}

Table BATCH_JOB_EXECUTION_PARAMS {
  JOB_EXECUTION_ID bigint [not null]
  PARAMETER_NAME varchar(100) [not null]
  PARAMETER_TYPE varchar(100) [not null]
  PARAMETER_VALUE varchar(2500)
  IDENTIFYING char(1) [not null]
}

Table BATCH_STEP_EXECUTION {
  STEP_EXECUTION_ID bigint [pk]
  VERSION bigint [not null]
  STEP_NAME varchar(100) [not null]
  JOB_EXECUTION_ID bigint [not null]
  CREATE_TIME timestamp [not null]
  START_TIME timestamp
  END_TIME timestamp
  STATUS varchar(10)
  COMMIT_COUNT bigint
  READ_COUNT bigint
  FILTER_COUNT bigint
  WRITE_COUNT bigint
  READ_SKIP_COUNT bigint
  WRITE_SKIP_COUNT bigint
  PROCESS_SKIP_COUNT bigint
  ROLLBACK_COUNT bigint
  EXIT_CODE varchar(2500)
  EXIT_MESSAGE varchar(2500)
  LAST_UPDATED timestamp
}

Table BATCH_STEP_EXECUTION_CONTEXT {
  STEP_EXECUTION_ID bigint [pk]
  SHORT_CONTEXT varchar(2500) [not null]
  SERIALIZED_CONTEXT text
}

Table BATCH_JOB_EXECUTION_CONTEXT {
  JOB_EXECUTION_ID bigint [pk]
  SHORT_CONTEXT varchar(2500) [not null]
  SERIALIZED_CONTEXT text
}

Ref: BATCH_JOB_INSTANCE.JOB_INSTANCE_ID < BATCH_JOB_EXECUTION.JOB_INSTANCE_ID
Ref: BATCH_JOB_EXECUTION.JOB_EXECUTION_ID < BATCH_JOB_EXECUTION_PARAMS.JOB_EXECUTION_ID
Ref: BATCH_JOB_EXECUTION.JOB_EXECUTION_ID < BATCH_STEP_EXECUTION.JOB_EXECUTION_ID
Ref: BATCH_STEP_EXECUTION.STEP_EXECUTION_ID - BATCH_STEP_EXECUTION_CONTEXT.STEP_EXECUTION_ID
Ref: BATCH_JOB_EXECUTION.JOB_EXECUTION_ID - BATCH_JOB_EXECUTION_CONTEXT.JOB_EXECUTION_ID

TableGroup RECOMMENDER_DB {
  recommender_post_view
  recommender_interaction_view
  recommender_follow_view
  recommender_block_view
  recommender_mute_view
  recommender_trending_post
  recommender_user_recommendation
}

TableGroup SPRING_BATCH {
  BATCH_JOB_INSTANCE
  BATCH_JOB_EXECUTION
  BATCH_JOB_EXECUTION_PARAMS
  BATCH_STEP_EXECUTION
  BATCH_STEP_EXECUTION_CONTEXT
  BATCH_JOB_EXECUTION_CONTEXT
}

// ============================================================
// 6. PAYMENT DB — payment-service
// Source of truth: orders, payment transactions, idempotency logs, outbox
// ============================================================
Table payment_orders {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  order_id varchar(64) [not null, unique]
  provider varchar(32) [not null, default: 'VNPAY', note: 'VNPAY / MOMO']
  product_code varchar(64) [not null, note: 'BLUE_TICK_1M, etc.']
  amount bigint [not null, note: 'check: amount > 0']
  currency varchar(8) [not null, default: 'VND']
  order_info varchar(255)
  status varchar(16) [not null, default: 'PENDING', note: 'PENDING / SUCCESS / FAILED / EXPIRED']
  provider_response_code varchar(8)
  provider_channel varchar(32)
  provider_pay_date timestamptz
  provider_transaction_no varchar(64)
  completed_event_id varchar(128)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  expired_at timestamptz [not null]

  Indexes {
    (provider, provider_transaction_no)
    completed_event_id
    user_id
    status
    expired_at
  }
}

Table payment_event_log {
  id uuid [pk]
  event_id varchar(128) [not null, unique]
  order_id varchar(64) [not null]
  provider varchar(32) [not null, default: 'VNPAY']
  response_code varchar(8)
  transaction_no varchar(64)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id
  }
}

Table payment_outbox {
  id uuid [pk]
  order_id varchar(64) [not null, unique]
  event_id varchar(128) [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / SENT / FAILED']
  attempts integer [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  lease_until timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]
  sent_at timestamptz

  Indexes {
    (status, next_attempt_at, created_at)
  }
}

Ref: payment_orders.order_id < payment_event_log.order_id
Ref: payment_orders.order_id - payment_outbox.order_id

TableGroup PAYMENT_DB {
  payment_orders
  payment_event_log
  payment_outbox
}

// ============================================================
// 7. NOTIFICATION DB — notification-service
// ============================================================
Table notifications {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  type varchar(50) [not null]
  actor_id uuid [note: 'Logical reference → auth_db.auth_users.id']
  target_type varchar(50)
  target_id varchar(255) [note: 'String representation to support compound / polymorphic target IDs']
  payload jsonb [not null]
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, created_at)
    (user_id, is_read)
    (target_type, target_id)
  }
}

Table device_tokens {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical reference → auth_db.auth_users.id']
  token varchar(500) [not null]
  platform varchar(20) [not null, note: 'ANDROID / IOS / WEB']
  last_seen_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    (user_id, token) [unique]
  }
}

Table notification_processed_events {
  id uuid [pk]
  topic varchar(200) [not null]
  event_id uuid [not null]
  processed_at timestamptz [not null, default: `now()`]

  Indexes {
    (topic, event_id) [unique]
  }

  Note: 'Idempotency key table: ensures at-most-once processing of incoming Kafka events.'
}

Table notification_push_outbox {
  id uuid [pk]
  notification_id uuid [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / SENT / FAILED']
  grouped_update boolean [not null, default: false]
  attempts integer [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  lease_until timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (status, next_attempt_at, created_at)
  }
}

Ref: notifications.id < notification_push_outbox.notification_id

TableGroup NOTIFICATION_DB {
  notifications
  device_tokens
  notification_processed_events
  notification_push_outbox
}

// ============================================================
// CROSS-SERVICE LOGICAL RELATIONSHIPS
// These Ref lines exist ONLY to make dbdiagram visually show
// architecture. They MUST NOT be copied into Flyway as SQL FKs.
// ============================================================

// AUTH → CONTENT
Ref: auth_users.id < content_posts.author_id
Ref: auth_users.id < content_comments.author_id
Ref: auth_users.id < content_comment_likes.user_id
Ref: auth_users.id < content_interactions.user_id
Ref: auth_users.id < content_follows.follower_id
Ref: auth_users.id < content_follows.following_id
Ref: auth_users.id < content_user_privacy_view.user_id
Ref: auth_users.id < content_saved_posts.user_id
Ref: auth_users.id < content_collections.user_id
Ref: auth_users.id < content_reports.reporter_id
Ref: auth_users.id < content_mutes.muter_id
Ref: auth_users.id < content_mutes.muted_id
Ref: auth_users.id < content_stories.author_id
Ref: auth_users.id < content_story_views.viewer_id
Ref: auth_users.id < content_highlights.user_id
Ref: auth_users.id < content_close_friends.owner_id
Ref: auth_users.id < content_close_friends.friend_id
Ref: auth_users.id < content_post_mentions.mentioned_user_id
Ref: auth_users.id < support_tickets.user_id
Ref: auth_users.id < support_tickets.responder_id

// MEDIA → CONTENT
Ref: media_files.id < content_posts.media_id
Ref: media_files.id < content_post_media.media_id
Ref: media_files.id < content_stories.media_id

// AUTH → CHAT
Ref: auth_users.id < chat_conversations.created_by
Ref: auth_users.id < chat_conversations.vanish_mode_set_by
Ref: auth_users.id < chat_conversation_members.user_id
Ref: auth_users.id < chat_messages.sender_id
Ref: auth_users.id < chat_message_reactions.user_id
Ref: auth_users.id < chat_conversation_read_status.user_id
Ref: auth_users.id < chat_message_hidden.user_id
Ref: auth_users.id < chat_pinned_messages.pinned_by
Ref: auth_users.id < chat_call_history.initiated_by

// MEDIA → CHAT
Ref: media_files.id < chat_messages.media_id

// AUTH → RECOMMENDER
Ref: auth_users.id < recommender_post_view.author_id
Ref: auth_users.id < recommender_interaction_view.user_id
Ref: auth_users.id < recommender_follow_view.follower_id
Ref: auth_users.id < recommender_follow_view.following_id
Ref: auth_users.id < recommender_block_view.blocker_id
Ref: auth_users.id < recommender_block_view.blocked_id
Ref: auth_users.id < recommender_mute_view.muter_id
Ref: auth_users.id < recommender_mute_view.muted_id
Ref: auth_users.id < recommender_trending_post.author_id
Ref: auth_users.id < recommender_user_recommendation.user_id
Ref: auth_users.id < recommender_user_recommendation.recommended_user_id

// CONTENT → RECOMMENDER
Ref: content_posts.id < recommender_post_view.post_id
Ref: content_posts.id < recommender_interaction_view.post_id
Ref: content_posts.id < recommender_trending_post.post_id

// AUTH → PAYMENT
Ref: auth_users.id < payment_orders.user_id

// AUTH → NOTIFICATION
Ref: auth_users.id < notifications.user_id
Ref: auth_users.id < notifications.actor_id
Ref: auth_users.id < device_tokens.user_id

// CONTENT / CHAT → NOTIFICATION (polymorphic target IDs are represented by fields, not direct FK)
// notifications.target_id → content_posts.id / content_comments.id / chat_messages.id / etc.

// BOT → CHAT / AUTH
// PLAN does not define bot DB schema, so relationships are intentionally not modeled yet.

// ============================================================
// ARCHITECTURE NOTES
// ============================================================
// 1. Inside one DB: use actual PostgreSQL FK and referential integrity.
// 2. Across DBs: only UUID reference + REST/Kafka/event synchronization.
// 3. Follow A→B + B→A are two rows. MUTUAL is computed.
// 4. Comment reply is self-reference with max depth = 1.
// 5. Block lives in auth_db; mute lives in content_db; downstream filters use events/projections.
// 6. Recommender is CQRS read-model and does not own content posts.
// 7. Before Flyway, convert only same-DB Ref lines into SQL FK constraints; keep cross-service refs as plain UUID columns.
// 9. auth_email_verifications: token is SHA-256 hashed before storage; raw token sent via email only once; 24h TTL.
// 10. auth_password_resets: token is SHA-256 hashed before storage; raw token sent via email only once; 15min TTL; single-use (used_at).
// 11. auth_users: is_banned, banned_at, ban_reason support Admin ban moderation (V3 migration).
// 12. Comment replies: Instagram-style flattening (replying to a child comment resolves parent_comment_id to root comment).
// 13. Blue tick verification: granted via payment.completed event, cumulative duration in verified_until.
// 14. Transactional Outbox pattern: payment_outbox and notification_push_outbox ensure reliable event delivery to Kafka and Push notification dispatchers without distributed transactions.
// 15. Idempotent Consumers: auth_payment_processed_events and notification_processed_events prevent duplicate execution of Kafka messages.
// 16. Spring Batch metadata: BATCH_* tables in recommender_db track job instances, executions, and step contexts.
