POSTGRES_USER=snapgram
POSTGRES_PASSWORD=snapgram

ADMIN_BOOTSTRAP_SECRET=your-super-secret-code

ADMIN_INITIAL_EMAIL=admin@snapgram.com
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-this-in-production
COOKIE_SECURE=false

DB_USER=snapgram
DB_PASSWORD=snapgram

MINIO_ENDPOINT=http://localhost:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=snapgram
MINIO_ROOT_PASSWORD=snapgram-minio-dev-password
MINIO_BUCKET=snapgram-media
MINIO_PUBLIC_URL=http://localhost:9000/snapgram-media

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GOOGLE_MAIL_USERNAME=your-email@gmail.com
GOOGLE_MAIL_PASSWORD=your-google-app-password
FRONTEND_URL=http://localhost:3000

SNAPGRAM_JWT_SECRET=your-super-secret-code
SNAPGRAM_JWT_ISSUER=snapgram-auth

SNAPGRAM_JWT_ACCESS_TOKEN_TTL=15m
SNAPGRAM_JWT_REFRESH_TOKEN_TTL=30d

PAYMENT_SERVICE_URL=http://localhost:8087
PAYMENT_FRONTEND_RESULT_URL=http://localhost:3000/payment/result

VNPAY_TMN_CODE=your_tmn_code_here
VNPAY_HASH_SECRET=your_hash_secret_here
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
# VNPay IPN URL: cau hinh tren merchant portal (Terminal/TmnCode), khong dung bien moi truong

# MoMo sandbox: https://test-payment.momo.vn — production: https://payment.momo.vn
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_IPN_URL=http://localhost:8080/api/payments/momo/ipn
MOMO_RETURN_URL=http://localhost:3000/payment/result
MOMO_REQUEST_TYPE=captureWallet
# PAYMENT_GRANT_BLUE_TICK=30d
# KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# AI Vision Caption & Hashtag Suggestions (Ollama Cloud Direct)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Swagger / OpenAPI documentation (true cho local/dev, false khi deploy production de bao mat)
SWAGGER_ENABLED=true
